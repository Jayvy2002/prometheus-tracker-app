# Copier vers `.env` (gitignoré). Placeholders uniquement — pas de secrets.
#
# Convention (lot 17d / ARCH12) :
# - `.env`              local, jamais Git
# - `.env.example`      forme des variables (ce fichier)
# - `.env.production`   clés **publiques** frontend du projet Prometheus (URL, anon, VAPID public)
# Pour ce dépôt : `cp .env.production .env`
# Jamais de `service_role` ni de secret serveur ici.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
